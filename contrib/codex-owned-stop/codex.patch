new file mode 100644
index 0000000..0f05b86
--- /dev/null
+++ b/codex-rs/core/src/unified_exec/turn_commands.rs
@@ -0,0 +1,104 @@
+use super::UnifiedExecProcess;
+use super::UnifiedExecProcessManager;
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::Ordering;
+
+// A command can be executing before item/started is emitted. Retain its native
+// handle independently of the tool future so cancellation cannot erase proof
+// of ownership or exit. Never derive ownership from OS process trees.
+#[derive(Default)]
+pub(super) struct CommandTurn {
+    pub(super) stopped: std::sync::atomic::AtomicBool,
+    pub(super) uncertain: std::sync::atomic::AtomicBool,
+    pub(super) startup: Arc<tokio::sync::RwLock<()>>,
+    pub(super) processes: std::sync::Mutex<HashMap<i32, Arc<UnifiedExecProcess>>>,
+}
+
+pub(super) struct CommandStart {
+    pub(super) turn: Arc<CommandTurn>,
+    pub(super) handle_retained: bool,
+    pub(super) _startup: tokio::sync::OwnedRwLockReadGuard<()>,
+}
+
+impl Drop for CommandStart {
+    fn drop(&mut self) {
+        if !self.handle_retained {
+            self.turn.uncertain.store(true, Ordering::Release);
+        }
+    }
+}
+
+impl UnifiedExecProcessManager {
+    pub(super) fn command_turn(&self, turn_id: &str) -> Arc<super::CommandTurn> {
+        let mut turns = self
+            .turn_commands
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        turns.retain(|id, turn| {
+            let mut processes = turn
+                .processes
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            processes.retain(|_, process| !process.has_exited());
+            id == turn_id
+                || turn.stopped.load(Ordering::Acquire)
+                || turn.uncertain.load(Ordering::Acquire)
+                || !processes.is_empty()
+                || Arc::strong_count(turn) > 1
+        });
+        Arc::clone(turns.entry(turn_id.to_owned()).or_default())
+    }
+
+    pub(crate) fn fence_turn_commands(&self, turn_id: &str) {
+        self.command_turn(turn_id)
+            .stopped
+            .store(true, Ordering::Release);
+    }
+
+    pub(crate) async fn stop_turn_commands(
+        &self,
+        turn_id: &str,
+        preserve: &[i32],
+    ) -> Result<Vec<i32>, String> {
+        let turn = self.command_turn(turn_id);
+        turn.stopped.store(true, Ordering::Release);
+        // A write barrier waits for every start admitted before the fence.
+        let startup = turn.startup.write().await;
+        let processes = turn
+            .processes
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        // The fence rejects later admissions. All earlier admissions have now
+        // retained a handle or recorded uncertainty, so release the barrier
+        // before waiting for process exits.
+        drop(startup);
+        if preserve.iter().any(|id| !processes.contains_key(id)) {
+            return Err("detached command is not owned by the selected turn".into());
+        }
+        let mut terminated = Vec::new();
+        for (id, process) in processes {
+            if preserve.contains(&id) {
+                continue;
+            }
+            process
+                .terminate_confirmed()
+                .await
+                .map_err(|e| format!("command {id} exit unconfirmed: {e}"))?;
+            turn.processes
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .remove(&id);
+            terminated.push(id);
+        }
+        if turn.uncertain.load(Ordering::Acquire) {
+            return Err(
+                "command startup was interrupted before ownership and exit could be confirmed"
+                    .into(),
+            );
+        }
+        terminated.sort();
+        Ok(terminated)
+    }
+}
