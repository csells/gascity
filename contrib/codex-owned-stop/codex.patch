+#[tokio::test]
+async fn owned_stop_waits_for_admitted_start_and_fences_only_its_turn() {
+    let manager = Arc::new(UnifiedExecProcessManager::default());
+    let turn = manager.command_turn("owned");
+    let starting = turn.startup.clone().read_owned().await;
+    manager.fence_turn_commands("owned");
+    let stopping_manager = Arc::clone(&manager);
+    let stopping =
+        tokio::spawn(async move { stopping_manager.stop_turn_commands("owned", &[]).await });
+    tokio::task::yield_now().await;
+    assert!(
+        !stopping.is_finished(),
+        "Stop bypassed an admitted command start"
+    );
+    assert!(turn.stopped.load(Ordering::Acquire));
+    assert!(
+        !manager
+            .command_turn("other")
+            .stopped
+            .load(Ordering::Acquire)
+    );
+    drop(starting);
+    assert_eq!(stopping.await.unwrap().unwrap(), Vec::<i32>::new());
+    assert_eq!(
+        manager.stop_turn_commands("owned", &[]).await.unwrap(),
+        Vec::<i32>::new()
+    );
+}
+
+#[tokio::test]
+async fn owned_stop_rejects_detach_without_native_ownership() {
+    let manager = UnifiedExecProcessManager::default();
+    assert!(manager.stop_turn_commands("owned", &[42]).await.is_err());
+}
+
+#[tokio::test]
+async fn owned_stop_never_acknowledges_an_unregistered_cancelled_start() {
+    let manager = UnifiedExecProcessManager::default();
+    let turn = manager.command_turn("uncertain");
+    let startup = turn.startup.clone().read_owned().await;
+    let admission = super::super::turn_commands::CommandStart {
+        turn: Arc::clone(&turn),
+        handle_retained: false,
+        _startup: startup,
+    };
+    // Dropping a future during local/remote spawn is not confirmed exit.
+    drop(admission);
+    assert!(manager.stop_turn_commands("uncertain", &[]).await.is_err());
+    // Retrying a lost result must not turn the uncertainty into success.
+    assert!(manager.stop_turn_commands("uncertain", &[]).await.is_err());
+    assert_eq!(
+        manager.stop_turn_commands("other", &[]).await.unwrap(),
+        Vec::<i32>::new()
+    );
+}
